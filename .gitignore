.DS_Store
.idea/
*.iml
__pycache__/
*.py[cod]
*$py.class

.env
.env.*
!.env.example

# Gradle / Kotlin
.gradle/
.kotlin/
build/
local.properties

# Xcode — project.yml is the source of truth, the pbxproj is generated
iosApp/*.xcodeproj/
iosApp/*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/
.swiftpm/

# Generated data artifacts. Large, reproducible, and deliberately outside
# version control.
/infra/.cache/
/infra/data/osm/*
!/infra/data/osm/.gitkeep
/infra/data/tiles/*
!/infra/data/tiles/.gitkeep
/infra/data/search/photon/photon.jar
/infra/data/search/photon/photon_data/
/infra/data/valhalla/
/infra/data/places/
/infra/tileserver/fonts/*
!/infra/tileserver/fonts/.gitkeep
/infra/tileserver/styles/osm-liberty/*
!/infra/tileserver/styles/osm-liberty/.gitkeep
!/infra/tileserver/styles/osm-liberty/README.md
