.DS_Store
.idea/
*.iml
__pycache__/
*.py[cod]
*$py.class

.env
.env.*
!.env.example

# Gradle / Kotlin
.gradle/
.kotlin/
build/
local.properties

# Xcode — project.yml is the source of truth, the pbxproj is generated
iosApp/*.xcodeproj/
iosApp/*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/
.swiftpm/

# Generated data artifacts. Large, reproducible, and per the plan they live
# OUTSIDE the source tree entirely — dmap2's grew to ~6.5 GB inside it.
# dmap2's are parked at ../dmap2-artifacts/.
#
# infra/ is rebuilt in P1 (see docs/dmap2-lessons.md). These patterns are here
# so the first heavy build cannot accidentally commit a tileset.
/infra/.cache/
/infra/data/
/infra/tileserver/fonts/*
!/infra/tileserver/fonts/.gitkeep
/infra/tileserver/styles/*
!/infra/tileserver/styles/.gitkeep
*.mbtiles
*.pmtiles
*.osm.pbf
