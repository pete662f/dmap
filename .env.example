# Copy to .env. Never commit .env — secret scanning and push protection are the
# backstop, but the habit is the actual defence.
#
# NOTE: backend URLs are NOT here any more. dmap2 resolved them through
# .env -> local.properties -> Gradle property -> BuildConfig, and rev. 3 of the
# plan replaced that with runtime settings in both apps (com.dmap.config.
# BackendConfig) because none of that machinery has an Xcode equivalent. Point
# each app at a host from its own settings screen instead.
#
# What remains here is server-side only: credentials the gateways need, which
# must never reach a client bundle.

# --- Ortofoto (GeoDanmark / Dataforsyningen) ------------------------------
# Prefer a token file outside the repo tree over an inline value.
# DMAP_ORTHOFOTO_TOKEN_FILE=/Users/you/.config/dmap/ortofoto-token
# DMAP_ORTHOFOTO_TOKEN=your-dataforsyningen-token
# DMAP_ORTHOFOTO_TIMEOUT_MS=8000

# --- Datafordeleren DAR (replaced DAWA, which closed 17 August 2026) ------
# DMAP_DATAFORDELEREN_USERNAME=
# DMAP_DATAFORDELEREN_PASSWORD=

# --- Rejseplanen API 2.0 (P5) --------------------------------------------
# Held by the transit-gateway ONLY. This key never goes in an APK or an IPA:
# the gateway is also where the 50k/month budget is metered and where the
# degrade-to-GTFS-static behaviour lives.
# DMAP_REJSEPLANEN_KEY=

# --- CVR / Virk (P2) -----------------------------------------------------
# DMAP_CVR_USERNAME=
# DMAP_CVR_PASSWORD=

# --- Local bind address --------------------------------------------------
# Gateways bind to 127.0.0.1 by default. Set 0.0.0.0 to let a physical phone on
# the LAN reach them.
# DMAP_BIND_HOST=127.0.0.1
